<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />

    <!-- So the module app can see the host package for scope resolution. -->
    <queries>
        <package android:name="com.alibaba.android.rimet" />
    </queries>

    <!-- REQUIRED: Android 11+ package visibility. Without this the module app cannot
         resolve LSPosed's XposedService provider, so XposedServiceHelper never receives
         the binder, the module reports 服务未连接/未激活, and LSPosed does not inject it
         into DingTalk (no logs, no location). Same block the working sibling declares. -->
    <queries>
        <intent>
            <action android:name="io.github.libxposed.service.provider" />
        </intent>
    </queries>

    <application
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/Theme.RimetMock"
        android:description="@string/xposed_description">

        <!-- No legacy xposed* meta-data: pure libxposed API 102 module. Identity (entry class,
             minApiVersion, scope) lives in META-INF/xposed/. -->

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".EditActivity"
            android:exported="false" />
    </application>

</manifest>
