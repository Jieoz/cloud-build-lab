<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Needed to read X's version into the export header; X is not otherwise
         visible to us under API 30+ package filtering. -->
    <queries>
        <package android:name="com.twitter.android" />
        <package android:name="com.twitter.android.beta" />
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@android:drawable/ic_menu_save"
        android:label="@string/app_name"
        android:supportsRtl="true">

        <!-- Legacy Xposed module descriptor. LSPosed identifies legacy modules by
             the presence of xposedminversion, then reads assets/xposed_init. -->
        <meta-data
            android:name="xposedmodule"
            android:value="true" />
        <meta-data
            android:name="xposeddescription"
            android:value="Probe: log X (Twitter) video playback URL resolution" />
        <meta-data
            android:name="xposedminversion"
            android:value="82" />
        <!-- Scope hint shown by the LSPosed manager. -->
        <meta-data
            android:name="xposedscope"
            android:resource="@array/xposedscope" />

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Receives probe records from X's process. Must be exported to be reachable
             across UIDs, so ProbeProvider checks the calling package on every call
             instead of relying on the manifest for access control. -->
        <provider
            android:name=".ProbeProvider"
            android:authorities="com.jiesa.xvideocatcher.probe"
            android:enabled="true"
            android:exported="true" />

        <!-- Publishes only the generated export file (files/export/), never the live
             log the writer thread is still appending to. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.jiesa.xvideocatcher.fileprovider"
            android:enabled="true"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
